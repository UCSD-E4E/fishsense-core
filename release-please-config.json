{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "fishsense-core",
      "include-component-in-tag": true,
      "changelog-path": "rust/fishsense-core/CHANGELOG.md",
      "extra-files": [
        {
          "type": "toml",
          "path": "rust/fishsense-core/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "python/fishsense_core/Cargo.toml",
          "jsonpath": "$.package.version"
        }
      ]
    }
  }
}
